{
  "name": "asynkron-jsengine-nodehostdemo",
  "version": "1.0.0",
  "description": "Node-shaped host examples for Asynkron.JsEngine.",
  "private": true,
  "main": "scripts/server.js",
  "scripts": {
    "express": "dotnet run --project . -- scripts/express/app.js",
    "official-express-ejs": "dotnet run --project . -- third_party/express/examples/ejs/index.js",
    "official-express-mvc": "dotnet run --project . -- third_party/express/examples/mvc/index.js",
    "prepare:official-express": "mkdir -p third_party && (test -d third_party/express/.git || git clone --depth 1 https://github.com/expressjs/express.git third_party/express) && npm --prefix third_party/express install",
    "prepare:official-express-ejs": "npm run prepare:official-express",
    "polka": "dotnet run --project . -- scripts/polka/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^4.22.2",
    "polka": "^0.5.2"
  }
}
