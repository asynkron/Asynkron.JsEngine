    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Asynkron.JsEngine.Generators\Asynkron.JsEngine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="StdLib/Intl/IntlLocaleData.json"/>
    <EmbeddedResource Include="StdLib/Intl/IntlLikelySubtags.json"/>
    <EmbeddedResource Include="StdLib/Intl/IntlWeekData.json"/>
  </ItemGroup>

</Project>
