#!/usr/bin/env bash
set -euo pipefail

# Force a stable locale so awk formats numbers with a '.' decimal separator.
export LC_ALL=C

# Node.js throughput regression gate for the evaluator hot paths.
#
# Measures timing for three profile scripts under both Node.js (via vm.Script)
# and Asynkron.JsEngine (via ProfileRunner --force-timing), computes the
# asynkron/node ratio for each profile, and compares against a committed
# baseline (tools/nodejs-baseline.json). Exits non-zero with a clear
# per-profile diff when any profile's ratio regresses beyond tolerance.
#
# A ratio of 1.0 means Asynkron is as fast as Node.js; 10.0 means 10× slower.
# The gate catches Asynkron regressions relative to Node.js, machine-normalized
# because both engines are measured on the same machine in the same run.
#
# Requires: node (any modern version that supports vm.Script and hrtime.bigint).
#
# Usage:
#   ./tools/check-nodejs-regression [--no-build] [--update] [--tolerance PCT]
#
#   (default)         Check current ratios against the committed baseline.
#   --update          Refresh tools/nodejs-baseline.json from a fresh run
#                     (use after an intentional change moves the numbers).
#   --no-build        Skip the ProfileRunner build (assume it is current).
#   --tolerance PCT   Allowed per-profile ratio regression, percent.
#                     Default 25 (overridable via NODEJS_GATE_TOLERANCE).
#
# Baseline-refresh path (one command):
#   ./tools/check-nodejs-regression --update
#   git add tools/nodejs-baseline.json && git commit

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
runner_project="$script_dir/ProfileRunner/ProfileRunner.csproj"
runner_bin="$script_dir/ProfileRunner/bin/Release/net10.0"
runner_exe="$runner_bin/ProfileRunner"
runner_dll="$runner_bin/ProfileRunner.dll"
baseline_file="$script_dir/nodejs-baseline.json"
scripts_dir="$script_dir/profile-scripts"

build_runner=true
update_baseline=false
tolerance_pct="${NODEJS_GATE_TOLERANCE:-25}"
runner_cmd=()

# Gate profile set. Format: key:script_filename:iterations
# iterations must match the corresponding profile-manifest.json entry.
gate_entries=(
  "fib:fib.js:10"
  "fib-iterative:fib-iterative.js:10"
  "objectcreation:objectcreation.js:20"
  "stringops:stringops.js:20"
)

usage() {
  cat <<'USAGE'
Usage:
  ./tools/check-nodejs-regression [--no-build] [--update] [--tolerance PCT]

Measures asynkron/node timing ratios for fib, fib-iterative, objectcreation, stringops and
compares them to tools/nodejs-baseline.json, failing when any ratio regresses
beyond tolerance (default 25%).

Options:
  --no-build        Skip the ProfileRunner Release build.
  --update          Refresh the committed baseline from a fresh run instead of
                    checking against it.
  --tolerance PCT   Allowed per-profile ratio regression in percent
                    (default 25; or set NODEJS_GATE_TOLERANCE).
  --help, -h        Show this help.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --no-build)
      build_runner=false
      shift
      ;;
    --update)
      update_baseline=true
      shift
      ;;
    --tolerance)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --tolerance" >&2
        exit 2
      fi
      tolerance_pct="$2"
      shift 2
      ;;
    --tolerance=*)
      tolerance_pct="${1#*=}"
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! [[ "$tolerance_pct" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "Invalid --tolerance value: $tolerance_pct" >&2
  exit 2
fi

if ! command -v node >/dev/null 2>&1; then
  echo "node not found. Install Node.js to use this gate." >&2
  exit 1
fi

if [[ "$build_runner" == true ]]; then
  dotnet build "$runner_project" -c Release -v q --nologo >/dev/null
fi

if [[ -x "$runner_exe" ]]; then
  runner_cmd=("$runner_exe")
elif [[ -f "$runner_dll" ]]; then
  runner_cmd=(dotnet "$runner_dll")
else
  echo "ProfileRunner was not found. Build it first or omit --no-build." >&2
  exit 1
fi

# Measure how long Node.js takes to run a profile script for N iterations
# (1 warmup + N measured). The script is wrapped in an IIFE so that let/const
# declarations are scoped per-call and do not bleed into the shared vm context.
# Outputs total elapsed ms as a decimal string.
measure_node_ms() {
  local sp=$1
  local n=$2
  node -e "
    var vm = require('vm');
    var fs = require('fs');
    var raw = fs.readFileSync('${sp}', 'utf8');
    var code = '(function(){\n' + raw + '\n}());';
    var s = new vm.Script(code);
    var ctx = vm.createContext({});
    s.runInContext(ctx);
    var t0 = process.hrtime.bigint();
    for (var k = 0; k < ${n}; k++) { s.runInContext(ctx); }
    var ms = Number(process.hrtime.bigint() - t0) / 1000000;
    process.stdout.write(ms.toFixed(2));
  "
}

# Measure how long Asynkron.JsEngine takes for a profile via ProfileRunner.
# Outputs total elapsed ms as an integer string.
measure_asynkron_ms() {
  local profile=$1
  local out status line ms

  set +e
  out=$("${runner_cmd[@]}" --asynkron --force-timing "$profile" 2>&1)
  status=$?
  set -e

  line=$(printf '%s\n' "$out" | awk '/Done in/ {line=$0} END {if (line) print line}')
  if [[ $status -ne 0 || -z "$line" ]]; then
    printf '\nasynkron %s failed:\n%s\n' "$profile" "$out" >&2
    return 1
  fi

  ms=$(printf '%s\n' "$line" | sed -n 's/.*Done in \([0-9][0-9]*\)ms.*/\1/p')
  if [[ -z "$ms" ]]; then
    printf '\nCould not parse timing for asynkron %s:\n%s\n' "$profile" "$line" >&2
    return 1
  fi

  printf '%s' "$ms"
}

measure_all() {
  local entry key rest sp n
  profile_keys=()
  node_values=()
  asynkron_values=()

  for entry in "${gate_entries[@]}"; do
    key="${entry%%:*}"
    rest="${entry#*:}"
    sp="$scripts_dir/${rest%%:*}"
    n="${rest#*:}"

    profile_keys+=("$key")
    node_values+=("$(measure_node_ms "$sp" "$n")")
    asynkron_values+=("$(measure_asynkron_ms "$key")")
  done
}

if [[ "$update_baseline" == true ]]; then
  echo "Measuring Node.js and Asynkron timings for the gate set ..." >&2
  measure_all

  {
    printf '{\n'
    printf '  "_comment": "Node.js vs Asynkron.JsEngine timing baseline (ratio = asynkron_ms / node_ms for the iteration loop).",\n'
    printf '  "_generated_by": "./tools/check-nodejs-regression --update",\n'
    printf '  "_note": "Refresh after an intentional throughput change: ./tools/check-nodejs-regression --update && git add tools/nodejs-baseline.json",\n'
    printf '  "profiles": {\n'
    local_idx=0
    last_idx=$((${#profile_keys[@]} - 1))
    for key in "${profile_keys[@]}"; do
      node_ms="${node_values[$local_idx]}"
      asynkron_ms="${asynkron_values[$local_idx]}"
      ratio=$(awk -v n="$node_ms" -v a="$asynkron_ms" 'BEGIN { printf "%.4f", (n > 0) ? a / n : 0 }')
      if [[ $local_idx -lt $last_idx ]]; then
        printf '    "%s": { "node_ms": %s, "asynkron_ms": %s, "ratio": %s },\n' \
          "$key" "$node_ms" "$asynkron_ms" "$ratio"
      else
        printf '    "%s": { "node_ms": %s, "asynkron_ms": %s, "ratio": %s }\n' \
          "$key" "$node_ms" "$asynkron_ms" "$ratio"
      fi
      local_idx=$((local_idx + 1))
    done
    printf '  }\n'
    printf '}\n'
  } >"$baseline_file"

  echo "Wrote baseline to $baseline_file:" >&2
  cat "$baseline_file" >&2
  exit 0
fi

if [[ ! -f "$baseline_file" ]]; then
  echo "Missing baseline: $baseline_file" >&2
  echo "Generate it with: ./tools/check-nodejs-regression --update" >&2
  exit 1
fi

# Read baseline ratio for a profile key using node to parse the JSON.
baseline_ratio_for() {
  local want=$1
  node -e "
    var b = require('${baseline_file}');
    var p = b.profiles && b.profiles['${want}'];
    if (p && p.ratio != null) { process.stdout.write(String(p.ratio)); }
  "
}

echo "Checking Asynkron/Node.js timing ratios against baseline (tolerance ${tolerance_pct}%) ..." >&2
measure_all

printf '%-22s %12s %14s %12s %12s %s\n' "profile" "node_ms" "asynkron_ms" "ratio" "base_ratio" "status"

regressed=false
idx=0
for key in "${profile_keys[@]}"; do
  node_ms="${node_values[$idx]}"
  asynkron_ms="${asynkron_values[$idx]}"
  idx=$((idx + 1))

  current_ratio=$(awk -v n="$node_ms" -v a="$asynkron_ms" \
    'BEGIN { printf "%.4f", (n > 0) ? a / n : 0 }')
  base_ratio=$(baseline_ratio_for "$key")

  if [[ -z "$base_ratio" ]]; then
    printf '%-22s %12s %14s %12s %12s %s\n' \
      "$key" "$node_ms" "$asynkron_ms" "$current_ratio" "n/a" "NO BASELINE"
    regressed=true
    continue
  fi

  read -r delta_pct status <<<"$(awk \
    -v base="$base_ratio" -v cur="$current_ratio" -v tol="$tolerance_pct" 'BEGIN {
      if (base <= 0) { printf "n/a BADBASE"; exit }
      pct = (cur - base) / base * 100.0
      if (pct > tol) {
        printf "%+.1f REGRESSED", pct
      } else {
        printf "%+.1f ok", pct
      }
    }')"

  printf '%-22s %12s %14s %12s %12s %s\n' \
    "$key" "$node_ms" "$asynkron_ms" "$current_ratio" "$base_ratio" "$status"

  if [[ "$status" == "REGRESSED" || "$status" == "BADBASE" ]]; then
    regressed=true
  fi
done

if [[ "$regressed" == true ]]; then
  echo "" >&2
  echo "Node.js throughput regression detected (tolerance ${tolerance_pct}%)." >&2
  echo "If this is an intentional change, refresh the baseline:" >&2
  echo "  ./tools/check-nodejs-regression --update && git add $baseline_file" >&2
  exit 1
fi

echo "" >&2
echo "OK: no Node.js throughput regression beyond ${tolerance_pct}% tolerance." >&2
