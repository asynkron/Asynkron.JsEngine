#!/usr/bin/env bash
set -euo pipefail

# Force a stable locale so awk formats numbers with a '.' decimal separator
# regardless of the host locale.
export LC_ALL=C

# Performance SLO gate for Asynkron.JsEngine.
#
# Re-measures timing for the instrumented SLOs (cold-start latency and
# microtask drain latency) and compares them to the committed baseline
# (tools/perf-slo-baseline.md). Exits non-zero with a clear per-profile
# diff when any profile's avg-ms-per-iteration regresses beyond the tolerance.
#
# This guards the committed ProfileRunner baseline from silently regressing.
# It also prints non-failing directional target evidence for the Performance
# SLO targets defined in docs/dreaming.md: p95 timing samples where a target is
# p95-shaped, plus same-run Node.js reference timing when node is available.
# Only committed avg-ms baseline regression is a hard failure. Timing is noisier
# than allocation bytes, so the default hard-failure tolerance is 200% (gate
# fails only when a measurement exceeds 3× baseline).
#
# Usage:
#   ./tools/check-slo-gate [--no-build] [--update] [--tolerance PCT]
#
#   (default)         Check current timing against the committed baseline.
#   --update          Refresh tools/perf-slo-baseline.md from a fresh run
#                     (use after an intentional change moves the numbers).
#   --no-build        Skip the ProfileRunner build (assume it is current).
#   --tolerance PCT   Allowed per-profile regression headroom, percent.
#                     Default 200 (overridable via TIMING_GATE_TOLERANCE).
#                     Gate fails when avg_ms > baseline_ms * (1 + pct/100).
#
# Directional targets reported by this gate (non-failing evidence):
#   startup   < 5 ms p95 target in docs/dreaming.md; shown as p95 status.
#   microtask < 1 ms per 1,000 queued jobs target; shown as avg status.
#
# Baseline-refresh path (one command):
#   ./tools/check-slo-gate --update
#   git add tools/perf-slo-baseline.md && git commit

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
runner_project="$script_dir/ProfileRunner/ProfileRunner.csproj"
runner_bin="$script_dir/ProfileRunner/bin/Release/net10.0"
runner_exe="$runner_bin/ProfileRunner"
runner_dll="$runner_bin/ProfileRunner.dll"
baseline_file="$script_dir/perf-slo-baseline.md"
scripts_dir="$script_dir/profile-scripts"

build_runner=true
update_baseline=false
tolerance_pct="${TIMING_GATE_TOLERANCE:-200}"
runner_cmd=()

# Profiles measured by this gate (must exist in profile-manifest.json).
slo_profiles=(
  startup
  microtask
)

target_for() {
  local profile=$1
  case "$profile" in
    startup)
      printf '5'
      ;;
    microtask)
      printf '1'
      ;;
    *)
      printf ''
      ;;
  esac
}

target_shape_for() {
  local profile=$1
  case "$profile" in
    startup)
      printf 'p95'
      ;;
    microtask)
      printf 'avg'
      ;;
    *)
      printf ''
      ;;
  esac
}

script_for() {
  local profile=$1
  case "$profile" in
    startup)
      printf 'startup.js'
      ;;
    microtask)
      printf 'microtask.js'
      ;;
    *)
      printf ''
      ;;
  esac
}

node_mode_for() {
  local profile=$1
  case "$profile" in
    microtask)
      printf 'async-drain'
      ;;
    *)
      printf 'sync'
      ;;
  esac
}

iterations_for() {
  local profile=$1
  case "$profile" in
    startup)
      printf '10'
      ;;
    microtask)
      printf '5'
      ;;
    *)
      printf '1'
      ;;
  esac
}

usage() {
  cat <<'USAGE'
Usage:
  ./tools/check-slo-gate [--no-build] [--update] [--tolerance PCT]

Re-measures ProfileRunner avg-ms-per-iteration for the SLO profile set and
compares them to tools/perf-slo-baseline.md, failing on regressions
beyond the tolerance (default 200% — fails only when measurement exceeds 3×
the baseline value). The output also includes non-failing directional target
status from docs/dreaming.md so baseline protection stays separate from SLO
target evidence. p95 timing and same-run Node.js comparison columns are
non-failing evidence; only avg-ms committed-baseline regression fails the gate.

Options:
  --no-build        Skip the ProfileRunner Release build.
  --update          Refresh tools/perf-slo-baseline.md from a fresh run instead
                    of checking against it.
  --tolerance PCT   Allowed per-profile regression headroom in percent
                    (default 200; or set TIMING_GATE_TOLERANCE).
                    Gate fails when avg_ms > baseline_ms * (1 + pct/100).
  --help, -h        Show this help.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --no-build)
      build_runner=false
      shift
      ;;
    --update)
      update_baseline=true
      shift
      ;;
    --tolerance)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --tolerance" >&2
        exit 2
      fi
      tolerance_pct="$2"
      shift 2
      ;;
    --tolerance=*)
      tolerance_pct="${1#*=}"
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! [[ "$tolerance_pct" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "Invalid --tolerance value: $tolerance_pct" >&2
  exit 2
fi

if [[ "$build_runner" == true ]]; then
  dotnet build "$runner_project" -c Release -v q --nologo >/dev/null
fi

if [[ -x "$runner_exe" ]]; then
  runner_cmd=("$runner_exe")
elif [[ -f "$runner_dll" ]]; then
  runner_cmd=(dotnet "$runner_dll")
else
  echo "ProfileRunner was not found. Build it first or omit --no-build." >&2
  exit 1
fi

# Run a single ProfileRunner profile with --force-timing and per-iteration
# timing samples. Prints "<avg_ms> <p95_ms>" parsed from ProfileRunner output.
measure_profile() {
  local profile=$1
  local out status line sample_line avg_ms p95_ms

  set +e
  out=$("${runner_cmd[@]}" --asynkron --force-timing --timing-samples "$profile" 2>&1)
  status=$?
  set -e

  line=$(printf '%s\n' "$out" | awk '/Done in/ {line=$0} END {if (line) print line}')
  sample_line=$(printf '%s\n' "$out" | awk '/Timing samples:/ {line=$0} END {if (line) print line}')
  if [[ $status -ne 0 || -z "$line" || -z "$sample_line" ]]; then
    printf '\nasynkron %s failed:\n%s\n' "$profile" "$out" >&2
    return 1
  fi

  # Parse "avg X.XXms per iteration" from the Done line (BSD + GNU sed portable).
  avg_ms=$(printf '%s\n' "$line" | sed -nE 's/.*avg ([0-9]+(\.[0-9]+)?)ms per iteration.*/\1/p')
  if [[ -z "$avg_ms" ]]; then
    printf '\nCould not parse avg timing for asynkron %s:\n%s\n' "$profile" "$line" >&2
    return 1
  fi

  p95_ms=$(printf '%s\n' "$sample_line" | sed -nE 's/.*p95_ms=([0-9]+(\.[0-9]+)?).*/\1/p')
  if [[ -z "$p95_ms" ]]; then
    printf '\nCould not parse p95 timing for asynkron %s:\n%s\n' "$profile" "$sample_line" >&2
    return 1
  fi

  printf '%s %s' "$avg_ms" "$p95_ms"
}

# Measure the same SLO workload in Node.js during this invocation. This is
# non-failing comparison evidence, not a committed-baseline gate.
measure_node_avg_ms() {
  local profile=$1 script iterations mode script_path

  if ! command -v node >/dev/null 2>&1; then
    printf 'n/a'
    return 0
  fi

  script=$(script_for "$profile")
  if [[ -z "$script" ]]; then
    printf 'n/a'
    return 0
  fi

  script_path="$scripts_dir/$script"
  iterations=$(iterations_for "$profile")
  mode=$(node_mode_for "$profile")

  node - "$script_path" "$iterations" "$mode" <<'NODE'
const fs = require('fs');
const vm = require('vm');

const [scriptPath, iterationText, mode] = process.argv.slice(2);
const iterations = Number(iterationText);
const raw = fs.readFileSync(scriptPath, 'utf8');
const code = '(function(){\n' + raw + '\n}());';
const script = new vm.Script(code);
const context = vm.createContext({});

async function runOnce() {
  script.runInContext(context);
  if (mode === 'async-drain') {
    await new Promise(resolve => setImmediate(resolve));
  }
}

(async () => {
  await runOnce();
  const start = process.hrtime.bigint();
  for (let i = 0; i < iterations; i++) {
    await runOnce();
  }

  const elapsedMs = Number(process.hrtime.bigint() - start) / 1000000;
  const avgMs = iterations > 0 ? elapsedMs / iterations : 0;
  process.stdout.write(avgMs.toFixed(4));
})().catch(error => {
  process.stderr.write(String(error && error.stack ? error.stack : error));
  process.exit(1);
});
NODE
}

target_status_for() {
  local profile=$1 avg_ms=$2 p95_ms=$3 target shape
  target=$(target_for "$profile")
  shape=$(target_shape_for "$profile")

  if [[ -z "$target" || -z "$shape" ]]; then
    printf 'n/a'
    return 0
  fi

  awk -v avg="$avg_ms" -v p95="$p95_ms" -v target="$target" -v shape="$shape" 'BEGIN {
    value = (shape == "p95") ? p95 : avg
    status = (value < target) ? "under-target" : "over-target"
    printf "%s-%s", shape, status
  }'
}

measure_all() {
  local include_node=${1:-true}
  local profile avg_ms p95_ms node_ms
  measured_values=()
  measured_p95_values=()
  node_values=()
  for profile in "${slo_profiles[@]}"; do
    read -r avg_ms p95_ms <<<"$(measure_profile "$profile")"
    measured_values+=("$avg_ms")
    measured_p95_values+=("$p95_ms")
    if [[ "$include_node" == true ]]; then
      node_ms=$(measure_node_avg_ms "$profile")
    else
      node_ms="n/a"
    fi
    node_values+=("$node_ms")
  done
}

if [[ "$update_baseline" == true ]]; then
  echo "Measuring SLO timing for the profile set ..." >&2
  measure_all false
  {
    echo "# Asynkron.JsEngine Performance SLO Baseline"
    echo "#"
    echo "# Committed baseline values for the Performance SLOs defined in docs/dreaming.md."
    echo "# Compared by tools/check-slo-gate."
    echo "#"
    echo "# Generated by: ./tools/check-slo-gate --update"
    echo "# Values are ProfileRunner --force-timing avg ms per iteration."
    echo "# Timing is hardware-dependent; regenerate on a new machine with --update then commit."
    echo "# Hard baseline tolerance: 200% by default (gate fails only at >3x baseline)."
    echo "# Override with TIMING_GATE_TOLERANCE or --tolerance."
    echo "# Directional target status is printed by tools/check-slo-gate but is non-failing evidence only."
    echo "# The startup target in docs/dreaming.md is p95; this file stores avg-ms guardrail values."
    echo "#"
    echo "# format: <profile> <avg_ms_per_iteration>"
    local_i=0
    for profile in "${slo_profiles[@]}"; do
      printf '%s %s\n' "$profile" "${measured_values[$local_i]}"
      local_i=$((local_i + 1))
    done
  } >"$baseline_file"
  echo "Wrote baseline to $baseline_file:" >&2
  grep -v '^#' "$baseline_file" >&2 || true
  exit 0
fi

if [[ ! -f "$baseline_file" ]]; then
  echo "Missing baseline: $baseline_file" >&2
  echo "Generate it with: ./tools/check-slo-gate --update" >&2
  exit 1
fi

# Look up the baseline avg_ms for a profile (portable; no associative arrays).
baseline_for() {
  local want=$1 profile ms _rest
  while read -r profile ms _rest; do
    [[ -z "$profile" || "$profile" == \#* ]] && continue
    if [[ "$profile" == "$want" ]]; then
      printf '%s' "$ms"
      return 0
    fi
  done <"$baseline_file"
  return 0
}

echo "Checking SLO timing against baseline (tolerance ${tolerance_pct}%) ..." >&2
measure_all

printf '%-12s %18s %18s %14s %18s %10s %-12s %-18s %12s %s\n' \
  "profile" "baseline_avg_ms" "current_avg_ms" "current_p95_ms" "hard_ceiling_ms" "delta_%" "baseline" "target_evidence" "node_avg_ms" "same_run"

regressed=false
i=0
for profile in "${slo_profiles[@]}"; do
  current="${measured_values[$i]}"
  current_p95="${measured_p95_values[$i]}"
  node_ms="${node_values[$i]}"
  i=$((i + 1))
  base=$(baseline_for "$profile")
  target_status=$(target_status_for "$profile" "$current" "$current_p95")
  if [[ "$node_ms" == "n/a" ]]; then
    same_run_status="node-unavailable"
  else
    same_run_status=$(awk -v cur="$current" -v node="$node_ms" 'BEGIN {
      if (node <= 0) {
        printf "node-bad"
      } else {
        printf "ratio=%.2fx", cur / node
      }
    }')
  fi

  if [[ -z "$base" ]]; then
    printf '%-12s %18s %18s %14s %18s %10s %-12s %-18s %12s %s\n' \
      "$profile" "n/a" "$current" "$current_p95" "n/a" "n/a" "NO BASELINE" "$target_status" "$node_ms" "$same_run_status"
    regressed=true
    continue
  fi

  read -r delta_pct hard_ceiling status <<<"$(awk -v base="$base" -v cur="$current" -v tol="$tolerance_pct" 'BEGIN {
    if (base <= 0) { printf "n/a n/a BADBASE"; exit }
    pct = (cur - base) / base * 100.0
    ceiling = base * (1.0 + tol / 100.0)
    if (cur > ceiling) {
      printf "%+.1f %.2f REGRESSED", pct, ceiling
    } else {
      printf "%+.1f %.2f ok", pct, ceiling
    }
  }')"
  if [[ "$status" == "BADBASE" ]]; then
    hard_ceiling="n/a"
  fi

  printf '%-12s %18s %18s %14s %18s %10s %-12s %-18s %12s %s\n' \
    "$profile" "$base" "$current" "$current_p95" "$hard_ceiling" "$delta_pct" "$status" "$target_status" "$node_ms" "$same_run_status"
  if [[ "$status" == "REGRESSED" || "$status" == "BADBASE" ]]; then
    regressed=true
  fi
done

if [[ "$regressed" == true ]]; then
  echo "" >&2
  echo "SLO timing regression detected (tolerance ${tolerance_pct}%)." >&2
  echo "If this is an intentional change, refresh the baseline:" >&2
  echo "  ./tools/check-slo-gate --update && git add $baseline_file" >&2
  exit 1
fi

echo "" >&2
echo "OK: no SLO timing regression beyond ${tolerance_pct}% tolerance." >&2
echo "Note: p95 target status and same-run Node.js comparison are non-failing evidence; only committed avg-ms baseline regression fails this gate." >&2
