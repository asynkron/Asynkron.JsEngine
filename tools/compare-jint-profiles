#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)
runner_project="$script_dir/ProfileRunner/ProfileRunner.csproj"
runner_bin="$script_dir/ProfileRunner/bin/Release/net10.0"
runner_exe="$runner_bin/ProfileRunner"
runner_dll="$runner_bin/ProfileRunner.dll"
build_runner=true
run_async_smoke=false
async_smoke_only=false
report_allocations=false
runner_cmd=()

smoke_profiles=(
  fib
  forloop
  ir-arithmetic
  functioncalls
  functioncalls-lite
)

default_profiles=(
  simplearithmetic
  fib
  forloop
  whileloop
  ir-arithmetic
  activation-noargs-lite
  activation-params-lite
  activation-arguments-lite
  activation-closures-lite
  activation-evalscope-lite
  objectcreation
  arrayops
  stringops
  propertyaccess
  classdef
  destructuring
  spread
  mapset
  json
  regex
  promise
  closures-lite
  recursion-lite
  forofiteration
  functioncalls
  functioncalls-lite
)

usage() {
  cat <<'USAGE'
Usage:
  ./tools/compare-jint-profiles [--no-build] [--smoke] [--allocations] [--async-smoke|--async-smoke-only] [profile...]

Runs the ProfileRunner timing scripts against Asynkron and Jint and prints one
repeatable comparison table.

Use --allocations to also measure managed allocated bytes during the measured
iteration loop for each engine process.

Smoke profiles:
  fib forloop ir-arithmetic functioncalls functioncalls-lite

Default profiles:
  simplearithmetic fib forloop whileloop ir-arithmetic activation-noargs-lite
  activation-params-lite activation-arguments-lite activation-closures-lite
  activation-evalscope-lite
  objectcreation arrayops stringops propertyaccess classdef destructuring spread
  mapset json regex promise closures-lite recursion-lite forofiteration
  functioncalls functioncalls-lite

This is not BenchmarkDotNet and does not run ./tools/profile --compare.
It intentionally avoids async/generator profiles in the timing table.

Test262 profiles are Asynkron-only because they depend on this repository's
$262 host harness. They are accepted as explicit profile arguments and report
Jint as n/a.

Use --async-smoke-only to run tiny Jint async/await probes separately. This
checks syntax/runtime behavior, not throughput.
USAGE
}

profiles=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --no-build)
      build_runner=false
      shift
      ;;
    --smoke)
      profiles=("${smoke_profiles[@]}")
      shift
      ;;
    --allocations|--memory)
      report_allocations=true
      shift
      ;;
    --async-smoke)
      run_async_smoke=true
      shift
      ;;
    --async-smoke-only)
      run_async_smoke=true
      async_smoke_only=true
      profiles=()
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      profiles+=("$1")
      shift
      ;;
  esac
done

if [[ ${#profiles[@]} -eq 0 && "$async_smoke_only" == false ]]; then
  profiles=("${default_profiles[@]}")
fi

if [[ "$build_runner" == true ]]; then
  dotnet build "$runner_project" -c Release -v q --nologo >/dev/null
fi

if [[ -x "$runner_exe" ]]; then
  runner_cmd=("$runner_exe")
else
  runner_cmd=(dotnet "$runner_dll")
fi

if [[ ! -x "$runner_exe" && ! -f "$runner_dll" ]]; then
  echo "ProfileRunner was not found. Build it first or omit --no-build." >&2
  exit 1
fi

profile_needs_iife_wrap() {
  case "$1" in
    simplearithmetic|whileloop|activation-*|objectcreation|arrayops|stringops|propertyaccess|classdef|destructuring|spread|mapset|json|regex|promise|recursion|recursion-lite|closures|closures-lite)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

run_engine() {
  local engine=$1
  local profile=$2
  local out status line ms allocated
  local args=("--$engine" "--force-timing")

  if [[ "$report_allocations" == true ]]; then
    args+=("--measure-allocations")
  fi

  if profile_needs_iife_wrap "$profile"; then
    args+=("--wrap-iife")
  fi

  set +e
  out=$("${runner_cmd[@]}" "${args[@]}" "$profile" 2>&1)
  status=$?
  set -e

  line=$(printf '%s\n' "$out" | awk '/Done in/ {line=$0} END {if (line) print line}')
  if [[ $status -ne 0 || -z "$line" ]]; then
    printf 'ERR'
    printf '\n%s %s failed:\n%s\n' "$engine" "$profile" "$out" >&2
    return 1
  fi

  ms=$(printf '%s\n' "$line" | sed -n 's/.*Done in \([0-9][0-9]*\)ms.*/\1/p')
  if [[ -z "$ms" ]]; then
    printf 'ERR'
    printf '\nCould not parse timing for %s %s:\n%s\n' "$engine" "$profile" "$line" >&2
    return 1
  fi

  allocated="n/a"
  if [[ "$report_allocations" == true ]]; then
    allocated=$(printf '%s\n' "$line" | sed -n 's/.*allocated \([0-9][0-9]*\) bytes.*/\1/p')
    if [[ -z "$allocated" ]]; then
      printf 'ERR'
      printf '\nCould not parse allocation count for %s %s:\n%s\n' "$engine" "$profile" "$line" >&2
      return 1
    fi
  fi

  printf '%s %s' "$ms" "$allocated"
}

format_kb() {
  local bytes=$1
  if [[ "$bytes" =~ ^[0-9]+$ ]]; then
    awk -v b="$bytes" 'BEGIN { printf "%.1f", b / 1024 }'
  else
    printf '%s' "$bytes"
  fi
}

format_delta() {
  local a=$1
  local j=$2
  local label=$3

  if [[ "$a" =~ ^[0-9]+$ && "$j" =~ ^[0-9]+$ && "$a" -gt 0 && "$j" -gt 0 ]]; then
    awk -v a="$a" -v j="$j" -v label="$label" 'BEGIN {
      if (a < j) {
        ratio = j / a
        if (ratio < 1.10) {
          printf "Tie"
        } else {
          printf "Asynkron %.2fx lower %s", ratio, label
        }
      } else if (j < a) {
        ratio = a / j
        if (ratio < 1.10) {
          printf "Tie"
        } else {
          printf "Jint %.2fx lower %s", ratio, label
        }
      } else {
        printf "Tie"
      }
    }'
  else
    printf 'n/a'
  fi
}

failed=false
if [[ ${#profiles[@]} -gt 0 ]]; then
  profile_width=22
  for profile in "${profiles[@]}"; do
    if [[ ${#profile} -gt $profile_width ]]; then
      profile_width=${#profile}
    fi
  done

  if [[ "$report_allocations" == true ]]; then
    printf "%-${profile_width}s %12s %14s %8s %11s  %-22s %s\n" "profile" "asynkron_ms" "asynkron_kb" "jint_ms" "jint_kb" "time_delta" "alloc_delta"
  else
    printf "%-${profile_width}s %12s %8s  %s\n" "profile" "asynkron_ms" "jint_ms" "delta"
  fi

  for profile in "${profiles[@]}"; do
    a_result=$(run_engine asynkron "$profile") || failed=true
    a_ms=${a_result%% *}
    a_alloc=${a_result#* }
    if [[ "$profile" == test262-* ]]; then
      j_ms="n/a"
      j_alloc="n/a"
    else
      j_result=$(run_engine jint "$profile") || failed=true
      j_ms=${j_result%% *}
      j_alloc=${j_result#* }
    fi

    if [[ "$a_ms" =~ ^[0-9]+$ && "$j_ms" =~ ^[0-9]+$ && "$a_ms" -gt 0 && "$j_ms" -gt 0 ]]; then
      delta=$(awk -v a="$a_ms" -v j="$j_ms" 'BEGIN {
        if (a < j) {
          ratio = j / a
          if (ratio < 1.10) {
            printf "Tie"
          } else {
            printf "Asynkron %.2fx faster", ratio
          }
        } else if (j < a) {
          ratio = a / j
          if (ratio < 1.10) {
            printf "Tie"
          } else {
            printf "Jint %.2fx faster", ratio
          }
        } else {
          printf "Tie"
        }
      }')
    else
      delta='n/a'
    fi

    if [[ "$report_allocations" == true ]]; then
      alloc_delta=$(format_delta "$a_alloc" "$j_alloc" "alloc")
      printf "%-${profile_width}s %12s %14s %8s %11s  %-22s %s\n" "$profile" "$a_ms" "$(format_kb "$a_alloc")" "$j_ms" "$(format_kb "$j_alloc")" "$delta" "$alloc_delta"
    else
      printf "%-${profile_width}s %12s %8s  %s\n" "$profile" "$a_ms" "$j_ms" "$delta"
    fi
  done
fi

if [[ "$run_async_smoke" == true ]]; then
  if [[ ${#profiles[@]} -gt 0 ]]; then
    printf '\n'
  fi
  printf 'Jint async smoke:\n'
  "${runner_cmd[@]}" jint-async-smoke
fi

if [[ "$failed" == true ]]; then
  exit 1
fi
